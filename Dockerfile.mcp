FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN pip install --no-cache-dir -U pip
COPY requirements-mcp.txt .
RUN pip install --no-cache-dir -r requirements-mcp.txt
# Content-extractor deps in a SEPARATE layer — resolving them together with the base graph
# segfaulted pip's resolver, so install them on top of the already-satisfied base.
RUN pip install --no-cache-dir trafilatura yt-dlp faster-whisper

# Draco GLB compression (draco_compress): gltf-transform CLI rides on node — own layer,
# same isolation principle as the extractor deps (python dep graph stays untouched).
RUN apt-get update \
    && apt-get install -y --no-install-recommends nodejs npm \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @gltf-transform/cli@4 \
    && npm cache clean --force

# Headless Blender for the 3D→pixel sprite bake (bake_sprite_sheet / character_to_sprites).
# The `bpy` wheel ships for CPython 3.11 ONLY (Blender tracks the VFX Reference Platform, which
# skipped 3.12 entirely: Blender 4.1-5.0 are cp311, 5.1+ jumps straight to cp313), so it lives in
# its OWN venv on a private 3.11 interpreter — the service's 3.12 dependency graph is untouched
# (same isolation principle as the extractor + gltf-transform layers). backend/blender_bake.py
# runs there as a subprocess (FORGE_BPY_PYTHON). Cycles renders on CPU; the X/GL libs are what
# the wheel links at import.
#
# That 3.11 comes from a relocatable python-build-standalone tarball, NOT from apt: this image is
# based on python:3.12-slim == Debian TRIXIE, which ships python3.13 and has no python3.11 package
# at all. Installing it with apt is what broke the first build of this layer (2026-09-14).
ARG PY311_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20260901/cpython-3.11.16%2B20260901-x86_64-unknown-linux-gnu-install_only.tar.gz
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libgl1 libglx0 libglvnd0 libvulkan1 libxkbcommon0 libx11-6 libxext6 libxfixes3 libxi6 \
       libxrender1 libxcb1 libxau6 libxdmcp6 libsm6 libice6 libbsd0 libmd0 libuuid1 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL "$PY311_URL" -o /tmp/py311.tar.gz \
    && mkdir -p /opt/py311 \
    && tar -xzf /tmp/py311.tar.gz -C /opt/py311 --strip-components=1 \
    && rm /tmp/py311.tar.gz \
    && /opt/py311/bin/python3.11 --version \
    && /opt/py311/bin/python3.11 -m venv /opt/bpy \
    && /opt/bpy/bin/pip install --no-cache-dir -U pip \
    && /opt/bpy/bin/pip install --no-cache-dir bpy==4.5.13 \
    && /opt/bpy/bin/python -c "import bpy; print('bpy', bpy.app.version_string)"
ENV FORGE_BPY_PYTHON=/opt/bpy/bin/python

COPY backend/__init__.py backend/processing.py backend/pixel_art.py backend/sprite_anim.py backend/bake_spec.py backend/blender_bake.py backend/sprite_bake.py backend/
COPY forge_mcp/ forge_mcp/

ENV U2NET_HOME=/models/u2net \
    FORGE_LAMA_DIR=/models \
    PYTHONUNBUFFERED=1

EXPOSE 5125
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s \
    CMD curl -fsS http://localhost:5125/health || exit 1

CMD ["python", "-m", "forge_mcp.server"]
